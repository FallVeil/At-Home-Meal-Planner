# Copy this file to ".env" and paste your free Spoonacular API key below.
# Get a key at: https://spoonacular.com/food-api/console#Dashboard  (free tier)
SPOONACULAR_API_KEY=your_key_here

# Optional: change the port the app runs on (default 3000)
PORT=3000

# Optional: cross-device sync for the planner + favorites (Upstash Redis, free).
# Create a free database at https://upstash.com, then paste its REST URL + token.
# If these are left blank, the app just saves to each device locally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Household passcode gate. Set APP_PASSCODE to lock the whole app (pages + API)
# behind a shared passcode. LEAVE IT BLANK and the app is OPEN to anyone with the
# URL — set it in Render's Environment settings to turn protection on.
# (Single-household mode: this passcode maps to the "andrew-katie" household.)
APP_PASSCODE=

# Multi-household mode: give each family its own passcode + isolated data.
# Format: "id:passcode" pairs, comma-separated. The id is the data namespace
# (no ":" or ","); the passcode is what they type to log in.
#   HOUSEHOLDS=andrew-katie:ourpass,smiths:theirpass
# When HOUSEHOLDS is set it takes over from APP_PASSCODE. Keep your own household
# id as "andrew-katie" so it lines up with the migrated data. Leave blank to stay
# in single-household (APP_PASSCODE) mode.
HOUSEHOLDS=

# Optional: a random cookie-signing key shared by all household sessions. If blank
# it's derived from the passcode set (so editing the roster logs everyone out).
# Set a long random string in Render to keep sessions stable across roster edits.
APP_SESSION_SECRET=

# Optional: override the id your original single-household data migrates into.
# Defaults to "andrew-katie"; must match your own id in HOUSEHOLDS.
LEGACY_HOUSEHOLD_ID=andrew-katie
