# Copy this file to ".env" and paste your free Spoonacular API key below.
# Get a key at: https://spoonacular.com/food-api/console#Dashboard  (free tier)
SPOONACULAR_API_KEY=your_key_here

# Optional: change the port the app runs on (default 3000)
PORT=3000

# Optional: cross-device sync for the planner + favorites (Upstash Redis, free).
# Create a free database at https://upstash.com, then paste its REST URL + token.
# If these are left blank, the app just saves to each device locally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
