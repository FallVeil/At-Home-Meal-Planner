# Copy this file to ".env" and paste your free Spoonacular API key below.
# Get a key at: https://spoonacular.com/food-api/console#Dashboard  (free tier)
SPOONACULAR_API_KEY=your_key_here

# Optional: change the port the app runs on (default 3000)
PORT=3000

# Optional: cross-device sync for the planner + favorites (Upstash Redis, free).
# Create a free database at https://upstash.com, then paste its REST URL + token.
# If these are left blank, the app just saves to each device locally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Household passcode gate. Set APP_PASSCODE to lock the whole app (pages + API)
# behind a shared passcode. LEAVE IT BLANK and the app is OPEN to anyone with the
# URL — set it in Render's Environment settings to turn protection on.
APP_PASSCODE=
# Optional: a random cookie-signing key. If blank it's derived from the passcode.
# Set a long random string to keep sessions valid even if you change the passcode.
APP_SESSION_SECRET=
